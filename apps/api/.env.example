# ============================================================================
# API Service - Environment Configuration Template
# ============================================================================

NODE_ENV=production
PORT=3000

# PostgreSQL Connection String (Supabase / Neon / AWS RDS / Local)
DATABASE_URL=postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT and Session Secrets
JWT_SECRET=super_secret_jwt_key_min_32_characters_long
SESSION_SECRET=super_secret_session_key_min_32_characters_long

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,https://your-domain.com

# File Upload Configuration
UPLOAD_DEST=uploads/documents
MAX_FILE_SIZE_MB=50
