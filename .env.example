# ============================================================================
# Construction ERP - Root Environment Configuration Template
# ============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Database Connection ---
# If using Supabase / Managed Cloud Postgres:
DATABASE_URL=postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# If using local Docker PostgreSQL service:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/construction_erp

# --- API Security & Auth ---
JWT_SECRET=generate_a_very_long_secure_random_string_here_min_32_chars
SESSION_SECRET=generate_another_secure_random_string_for_sessions

# --- CORS Origin Restriction ---
# In production, restrict to your frontend domain: e.g. https://erp.yourcompany.com
CORS_ORIGIN=http://localhost,http://localhost:5173,https://your-domain.com

# --- Port Configuration ---
PORT=3000
API_PORT=3000
WEB_PORT=80

# --- Local Docker DB Settings (Optional - if using local db container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=construction_erp
DB_PORT=5432
